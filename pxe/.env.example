# Copy to .env.local for local development. Never commit real values.

# Demo catalogue (fictional, labeled "Demo"). Defaults: on in development,
# off in production. Read at build time — rebuild after changing it.
PXE_DEMO_MODE=

# Public support address shown in the footer and on /teach. Hidden when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

