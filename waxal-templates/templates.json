{
  "brand": {
    "background": "#17110E",
    "panel": "#211915",
    "cream": "#F5EDE4",
    "green": "#0F8A5F",
    "amber": "#E0A32E",
    "terracotta": "#C2542F",
    "fonts": {
      "display": "Archivo Black",
      "ui": "Archivo",
      "mono": "IBM Plex Mono"
    }
  },
  "overlayTextTemplates": [
    {
      "id": "bold-headline",
      "name": "Bold headline",
      "font": "Archivo Black",
      "transform": "uppercase",
      "size": "clamp(28px, 8cqw, 64px)",
      "color": "#F5EDE4",
      "position": { "vertical": "top", "horizontal": "center", "offset": "12%" },
      "animation": { "type": "rise-fade-in", "duration": 0.6 },
      "sample": "TERANGA"
    },
    {
      "id": "lower-third",
      "name": "Lower third",
      "structure": ["label", "name"],
      "label": { "font": "IBM Plex Mono", "color": "#E0A32E", "size": "12px", "transform": "uppercase", "letterSpacing": "0.15em" },
      "nameLine": { "font": "Archivo", "weight": 800, "color": "#F5EDE4", "size": "20px" },
      "plate": { "background": "rgba(23,17,14,0.85)", "accentBar": { "side": "left", "width": "4px", "color": "#0F8A5F" }, "padding": "10px 16px" },
      "position": { "vertical": "bottom", "horizontal": "left", "offset": "18%" },
      "animation": { "type": "slide-in-left", "duration": 0.5 },
      "sample": { "label": "DAKAR · SÉNÉGAL", "name": "Aminata Diallo" }
    },
    {
      "id": "quote-card",
      "name": "Quote card",
      "font": "Archivo",
      "weight": 700,
      "color": "#17110E",
      "card": { "background": "rgba(245,237,228,0.92)", "radius": "16px", "padding": "20px 24px", "quoteMark": { "char": "“", "color": "#C2542F", "size": "48px" } },
      "position": { "vertical": "center", "horizontal": "center" },
      "animation": { "type": "scale-in", "from": 0.92, "duration": 0.5 },
      "sample": "Ndank ndank mooy jàpp golo ci ñaay."
    },
    {
      "id": "ticker",
      "name": "Ticker",
      "font": "IBM Plex Mono",
      "size": "14px",
      "color": "#17110E",
      "strip": { "background": "#E0A32E", "height": "34px", "fullWidth": true },
      "position": { "vertical": "bottom", "horizontal": "stretch", "offset": "0" },
      "animation": { "type": "marquee", "speed": "60px/s", "loop": true },
      "sample": "WAXAL · SA HISTOIRE · SA LÀKK · SA WIDEWO · "
    },
    {
      "id": "kinetic-word",
      "name": "Kinetic word",
      "font": "Archivo Black",
      "transform": "uppercase",
      "size": "clamp(48px, 16cqw, 110px)",
      "color": "#E0A32E",
      "position": { "vertical": "center", "horizontal": "center" },
      "animation": { "type": "spring-pop", "scale": [1.0, 1.15, 1.0], "duration": 0.45 },
      "sample": "XUMB!"
    },
    {
      "id": "woven-banner",
      "name": "Woven banner",
      "font": "Archivo",
      "weight": 800,
      "color": "#F5EDE4",
      "band": {
        "background": "#C2542F",
        "borders": { "motif": "woven-stripe", "colors": ["#E0A32E", "#0F8A5F", "#F5EDE4"], "height": "6px" },
        "padding": "14px 0"
      },
      "position": { "vertical": "bottom", "horizontal": "stretch", "offset": "28%" },
      "animation": { "type": "fade-in", "duration": 0.4 },
      "sample": "Benn réew, benn taariix"
    }
  ],
  "captionStyleTemplates": [
    {
      "id": "box",
      "name": "Box",
      "plate": { "background": "rgba(23,17,14,0.85)", "radius": "10px", "padding": "8px 14px" },
      "text": { "font": "Archivo", "weight": 700, "color": "#F5EDE4", "size": "clamp(16px, 4.5cqw, 24px)" },
      "gloss": { "color": "rgba(245,237,228,0.6)", "size": "0.75em" },
      "position": "lower-third-center"
    },
    {
      "id": "plain",
      "name": "Plain",
      "plate": null,
      "text": { "font": "Archivo", "weight": 700, "color": "#FFFFFF", "shadow": "0 2px 12px rgba(0,0,0,0.8)" },
      "position": "lower-third-center"
    },
    {
      "id": "karaoke",
      "name": "Karaoke",
      "plate": null,
      "text": { "font": "Archivo", "weight": 800, "base": "rgba(245,237,228,0.55)", "activeFill": "#E0A32E" },
      "wordTiming": "interpolate words across the line duration; fill each word amber as its time passes",
      "position": "lower-third-center"
    },
    {
      "id": "outline",
      "name": "Outline",
      "plate": null,
      "text": { "font": "Archivo Black", "transform": "uppercase", "color": "#F5EDE4", "stroke": "6px #17110E", "technique": "paint-order: stroke; -webkit-text-stroke" },
      "position": "lower-third-center"
    },
    {
      "id": "gold",
      "name": "Gold",
      "plate": null,
      "text": { "font": "Archivo", "weight": 800, "color": "#E0A32E", "glow": "0 0 18px rgba(224,163,46,0.55)" },
      "position": "lower-third-center"
    },
    {
      "id": "stack",
      "name": "Stack",
      "plate": { "background": "rgba(23,17,14,0.75)", "accentBar": { "side": "left", "width": "4px", "color": "#0F8A5F" }, "padding": "8px 12px" },
      "text": { "font": "Archivo", "weight": 700, "color": "#F5EDE4", "align": "left", "maxLines": 2 },
      "position": "lower-third-left"
    }
  ],
  "captionLineSchema": {
    "at": "seconds from clip start (number)",
    "wo": "Wolof caption line, max ~42 chars",
    "fr": "French gloss",
    "en": "English gloss"
  }
}
