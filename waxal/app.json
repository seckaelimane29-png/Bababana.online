{
  "expo": {
    "name": "Waxal",
    "slug": "waxal",
    "scheme": "waxal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070B",
    "ios": {
      "bundleIdentifier": "online.bababana.waxal",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "online.bababana.waxal",
      "adaptiveIcon": {
        "backgroundColor": "#07070B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#07070B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Waxal needs access to your videos so you can add captions to them.",
          "cameraPermission": "Waxal uses the camera to record new videos.",
          "microphonePermission": "Waxal uses the microphone to record audio with your videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Waxal needs access to your library to save exported videos.",
          "savePhotosPermission": "Waxal saves your captioned videos to your library.",
          "granularPermissions": ["video"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
