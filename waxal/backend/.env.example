# Copy to .env and fill in. NEVER commit the real .env file.

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for caption generation
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite for dev; use a postgres:// URL in production
DATABASE_URL=sqlite:///./waxal.db

UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# Generate a long random string for production, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Monthly quotas and Pro price (CFA francs)
FREE_MONTHLY_GENERATIONS=10
PRO_MONTHLY_GENERATIONS=500
PRO_PRICE_FCFA=2500

# true = the Upgrade button activates Pro instantly WITHOUT payment (local testing only)
DEV_FAKE_BILLING=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
